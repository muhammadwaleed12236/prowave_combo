<IfModule mod_passenger.c>
    PassengerEnabled off
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 2. Block access to sensitive files
    RewriteRule ^\.env.*$ - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]
    RewriteRule ^package(-lock)?\.json$ - [F,L]
    RewriteRule ^artisan$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests)(/|$) - [F,L]

    # 3. Serve physical static files directly (images, css, js, fonts)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 4. Serve uploads, placeholders and storage from public folder
    RewriteCond %{DOCUMENT_ROOT}/public/uploads/$1 -f
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

    RewriteCond %{DOCUMENT_ROOT}/public/placeholders/$1 -f
    RewriteRule ^placeholders/(.*)$ public/placeholders/$1 [L]

    RewriteCond %{DOCUMENT_ROOT}/public/storage/$1 -f
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    # 5. Route all other requests to Laravel index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>
